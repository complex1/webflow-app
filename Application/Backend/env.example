# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_PATH=./database.sqlite

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS Configuration (comma-separated origins; omit in development to allow *)
# In production, set explicitly (e.g. https://app.example.com). Leave unset only if UI is same-origin.
CORS_ORIGIN=http://localhost:5173

# HTTP proxy (used by workflow HTTP nodes). In production, set a comma-separated hostname allowlist.
# Example: PROXY_ALLOWED_HOSTS=api.example.com,jsonplaceholder.typicode.com
# PROXY_ALLOW_OPEN=true  # emergency only: allow any host when allowlist is empty (never in production)
PROXY_ALLOWED_HOSTS=

